{
  "name": "@lsby/lens-box-argumentation-lens",
  "version": "0.1.0",
  "private": true,
  "description": "基于大模型结构化提取与本地有向论证图的文本论证结构剖析透镜",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
